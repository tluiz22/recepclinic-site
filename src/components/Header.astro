---
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="site-header">
  <div class="container bar">
    <Logo />
    <ThemeToggle />
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 68px;
  }
</style>
