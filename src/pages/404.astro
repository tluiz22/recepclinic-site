---
import Base from '../layouts/Base.astro';
---

<Base title="Página não encontrada" description="Esta página não existe." noindex>
  <section class="container not-found">
    <span class="eyebrow">Erro 404</span>
    <h1>Página não encontrada</h1>
    <p class="muted">O endereço pode ter mudado ou estar digitado errado.</p>
    <p><a href="/">Voltar ao início</a></p>
  </section>
</Base>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-top: 56px;
  }
</style>
